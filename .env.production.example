# =============================================================================
# CADRI - Production environment template
# =============================================================================
#
# This file documents the environment variables required by CADRI in a
# production environment.
#
# Copy this template to a private .env file on the production server and
# replace every placeholder with a real value.
#
# Never commit real passwords, private keys, tokens or application secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Flask environment
# -----------------------------------------------------------------------------
# Forces the backend to load ProductionConfig instead of DevelopmentConfig.

FLASK_ENV=production


# -----------------------------------------------------------------------------
# Application secrets
# -----------------------------------------------------------------------------
# Generate strong and independent random values for each secret.
#
# Example:
#   openssl rand -hex 32
#
# Never reuse the same value for SECRET_KEY and JWT_SECRET_KEY.

SECRET_KEY=replace-with-a-strong-random-secret
JWT_SECRET_KEY=replace-with-another-strong-random-secret


# -----------------------------------------------------------------------------
# PostgreSQL database
# -----------------------------------------------------------------------------

POSTGRES_DB=cadri_db
POSTGRES_USER=cadri_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# SQLAlchemy uses this URL to connect the backend to PostgreSQL.
DATABASE_URL=postgresql://cadri_user:replace-with-a-strong-database-password@db:5432/cadri_db


# -----------------------------------------------------------------------------
# Public application URLs
# -----------------------------------------------------------------------------

# Public URL of the React application.
# The backend also uses this value for CORS and email links.
FRONTEND_URL=https://cadri.example.com

# Public path used by the frontend to contact the backend API.
#
# The recommended production architecture exposes backend routes through
# Nginx under /api to avoid conflicts with React routes such as /missions.
#
# This value is used by Vite at build time and must therefore also be passed
# to the frontend production build.
VITE_API_BASE_URL=/api


# -----------------------------------------------------------------------------
# JWT access tokens
# -----------------------------------------------------------------------------

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_DECODE_LEEWAY_SECONDS=2


# -----------------------------------------------------------------------------
# Account activation and password reset
# -----------------------------------------------------------------------------

ACCOUNT_ACTIVATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=2


# -----------------------------------------------------------------------------
# Refresh tokens
# -----------------------------------------------------------------------------

REFRESH_TOKEN_EXPIRES_DAYS=7

REFRESH_COOKIE_NAME=refresh_token

# The browser must send the refresh cookie to the public authentication route.
# If the production API is exposed under /api, the public path is /api/auth.
REFRESH_COOKIE_PATH=/api/auth

# Production authentication cookies must only be transmitted over HTTPS.
REFRESH_COOKIE_SECURE=true

REFRESH_COOKIE_SAMESITE=Lax


# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# Replace these placeholders with the real production mail server settings.
#
# The current CADRI EmailService uses a basic SMTP connection without SMTP
# authentication or STARTTLS. Additional backend configuration would be
# required if the selected provider requires those features.

MAIL_SERVER=smtp.example.com
MAIL_PORT=25
MAIL_DEFAULT_SENDER=no-reply@cadri.example.com
